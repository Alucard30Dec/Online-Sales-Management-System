@model OnlineSalesManagementSystem.Areas.Admin.ViewModels.Auth.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSMS Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/assets/images/favicon.svg" />
    <link rel="stylesheet" href="~/css/admin-login.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-hero">
            <div class="login-hero__content">
                <img class="login-hero__logo" src="~/assets/images/logo/logo.svg" alt="OSMS" />
                <p class="login-hero__eyebrow">OSMS Admin Portal</p>
                <h1>Đăng nhập nhanh để vào thẳng khu vực quản trị.</h1>
                <p class="login-hero__text">
                    Giao diện đăng nhập đã được tối ưu để tải nhẹ hơn, không phụ thuộc CDN và không gọi ảnh ngoài.
                </p>
                <ul class="login-hero__metrics">
                    <li>Bán hàng</li>
                    <li>Tồn kho</li>
                    <li>Báo cáo</li>
                </ul>
            </div>
        </section>

        <section class="login-panel">
            <div class="login-card">
                <div class="login-card__head">
                    <p class="login-card__kicker">Xin chào</p>
                    <h2>Đăng nhập hệ thống</h2>
                    <p class="login-card__sub">Dùng tài khoản quản trị để tiếp tục.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-alert" asp-validation-summary="All"></div>
                }

                <form asp-area="Admin" asp-controller="Auth" asp-action="Login" method="post" class="login-form">
                    <input type="hidden" asp-for="ReturnUrl" />
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <label asp-for="Email">Email hoặc tài khoản</label>
                        <input asp-for="Email" type="text" autocomplete="username" placeholder="admin@osms.local" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field">
                        <div class="field__row">
                            <label asp-for="Password">Mật khẩu</label>
                        </div>
                        <div class="password-wrap">
                            <input asp-for="Password" id="passwordInput" type="password" autocomplete="current-password" placeholder="••••••••" />
                            <button type="button" class="password-toggle" onclick="togglePassword()">Hiện</button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <label class="checkbox">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>

                    <button type="submit" class="login-submit">Đăng nhập</button>
                </form>

                <div class="login-accounts">
                    <p>Tài khoản mặc định</p>
                    <div><strong>Admin:</strong> <code>admin@osms.local</code> / <code>Admin@12345</code></div>
                    <div><strong>Sales:</strong> <code>sales@osms.local</code> / <code>Sales@12345</code></div>
                </div>
            </div>
        </section>
    </main>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("passwordInput");
            const toggle = document.querySelector(".password-toggle");
            const showing = passwordInput.type === "text";
            passwordInput.type = showing ? "password" : "text";
            toggle.textContent = showing ? "Hiện" : "Ẩn";
        }
    </script>
</body>
</html>
