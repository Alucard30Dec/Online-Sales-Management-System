@model OnlineSalesManagementSystem.Domain.Entities.Invoice
@using OnlineSalesManagementSystem.Domain.Entities
@{
    ViewData["Title"] = "Chi ti?t Ha don";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    string badgeClass = Model.Status switch
    {
        InvoiceStatus.Paid => "status-paid",
        InvoiceStatus.Cancelled => "status-cancelled",
        _ => "status-pending"
    };
    string statusLabel = Model.Status switch
    {
        InvoiceStatus.Paid => " thanh ton",
        InvoiceStatus.Cancelled => " h?y",
        _ => "Ch? thanh ton"
    };

    var due = Math.Max(0m, Model.GrandTotal - Model.PaidAmount);
}

<link rel="stylesheet" href="~/css/invoices-ui.css" />

<div class="container-fluid py-4" style="background-color: #f8f9fc;">

    <div class="hero-header mb-4">
        <div class="d-flex justify-content-between align-items-start position-relative" style="z-index: 1;">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom mb-2">
                        <li class="breadcrumb-item"><a href="/Admin/Invoices">Ha don</a></li>
                        <li class="breadcrumb-item active">Chi ti?t</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-1">Ha don #@Model.InvoiceNo</h2>
                <div class="d-flex align-items-center gap-3 mt-2">
                    <span class="badge-status @badgeClass">@statusLabel</span>
                    <span class="text-muted small"><i class="far fa-calendar-alt me-1"></i> @Model.InvoiceDate.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary rounded-pill px-4" href="/Admin/Invoices">Quay l?i</a>
                <a class="btn btn-outline-primary rounded-pill px-4" href="/Admin/Invoices/Print/@Model.Id" target="_blank"><i class="fas fa-print me-2"></i>In phi?u</a>

                @if (Model.Status != InvoiceStatus.Cancelled)
                {
                    <form method="post" action="/Admin/Invoices/Cancel/@Model.Id" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('H?y ha don v hon tr? t?n kho?');">
                            <i class="fas fa-ban me-2"></i>H?y don
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card card-modern h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="fw-bold text-dark mb-0">Chi ti?t s?n ph?m</h5>
                    <div class="text-muted small">Khách hàng: @if (Model.CustomerId.HasValue) { <a id="invoiceCustomerLink" class="customer-link text-danger fw-bold" href="/Admin/Customers/Details/@Model.CustomerId" data-customer-id="@Model.CustomerId">@(Model.Customer?.Name ?? "Khách hàng")</a> } else { <span class="text-muted fw-bold">Khách lẻ (Walk-in)</span> }</div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width:60px;">#</th>
                                    <th>S?n ph?m</th>
                                    <th class="text-center" style="width:100px;">SL</th>
                                    <th class="text-end" style="width:150px;">on gi</th>
                                    <th class="text-end pe-4" style="width:150px;">Thnh ti?n</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items == null || Model.Items.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Khng c s?n ph?m no.</td></tr>
                                }
                                else
                                {
                                    int stt = 1;
                                    foreach (var it in Model.Items)
                                    {
                                        <tr>
                                            <td class="ps-4 text-muted">@stt</td>
                                            <td>
                                                <div class="fw-bold text-dark">@it.Product?.Name</div>
                                            </td>
                                            <td class="text-center fw-semibold">@it.Qty</td>
                                            <td class="text-end text-muted">@it.UnitPrice.ToString("N0")</td>
                                            <td class="text-end pe-4 fw-bold">@it.LineTotal.ToString("N0")</td>
                                        </tr>
                                        stt++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (Model.Status != InvoiceStatus.Cancelled)
            {
                <div class="card card-modern mt-4">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h6 class="fw-bold text-dark"><i class="fas fa-wallet me-2 text-success"></i>Ghi nh?n thanh ton</h6>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <form method="post" action="/Admin/Invoices/RecordPayment/@Model.Id" class="row g-3 align-items-end">
                            @Html.AntiForgeryToken()
                            <div class="col-md-6">
                                <label class="form-label small text-muted fw-bold">S? ti?n thanh ton thm</label>
                                <div class="input-group">
                                    <input class="form-control" type="number" name="amount" step="0.01" min="0" required placeholder="Nh?p s? ti?n..." />
                                    <span class="input-group-text">VN</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-success w-100 fw-bold" type="submit">Xc nh?n</button>
                            </div>
                            <div class="col-md-3 text-muted small">
                                Cn n?: <strong class="text-danger h6">@due.ToString("N0") d</strong>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="col-12 col-xl-4">
            <div class="card card-modern mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">T?ng thanh ton</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">T?ng ti?n hng:</span>
                        <span class="fw-semibold">@Model.SubTotal.ToString("N0") d</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="fw-bold text-dark h5 mb-0">T?ng c?ng:</span>
                        <span class="fw-bold text-danger h4 mb-0">@Model.GrandTotal.ToString("N0") d</span>
                    </div>

                    <div class="mt-4 pt-3 border-top border-dashed">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-success"><i class="fas fa-check-circle me-1"></i> tr?:</span>
                            <span class="fw-bold text-success">@Model.PaidAmount.ToString("N0") d</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Cn n?:</span>
                            <span class="fw-bold text-danger">@due.ToString("N0") d</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info shadow-sm border-0 small rounded-3">
                <i class="fas fa-info-circle me-2"></i>
                Ha don ny d tr? t?n kho s?n ph?m. N?u h?y, t?n kho s? du?c hon tr? l?i.
            </div>
        </div>
    </div>
</div>
 

<div id="customerHoverCard" class="customer-hover-card"></div>

@section Scripts {
<script>

    // ==============================
    // Customer hover card (fixed overlay, no layout shift)
    // ==============================
    const customerHoverCard = document.getElementById('customerHoverCard');
    const customerCache = new Map();

    function escapeHtml(s) {
        if (s === null || s === undefined) return '';
        return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    function renderCustomerCard(data) {
        if (!customerHoverCard) return;
        customerHoverCard.innerHTML = `
            <div class="title">${escapeHtml(data.name || 'Khách hàng')}</div>
            <div class="line"><strong>SĐT:</strong> ${escapeHtml(data.phone || '—')}</div>
            <div class="line"><strong>Email:</strong> ${escapeHtml(data.email || '—')}</div>
            <div class="line"><strong>Địa chỉ:</strong> ${escapeHtml(data.address || '—')}</div>
            <div class="muted mt-2">
                <span><strong>Tổng đơn:</strong> ${escapeHtml(data.totalOrders ?? '0')}</span>
                &nbsp;|&nbsp;
                <span><strong>Đã chi:</strong> ${escapeHtml(data.totalSpentText || '0 VNĐ')}</span>
            </div>
        `;
    }

    function placeCardNear(el) {
        if (!customerHoverCard || !el) return;
        const r = el.getBoundingClientRect();
        const pad = 10;

        // default: show under-right of trigger
        let top = r.bottom + 8;
        let left = Math.min(r.right - 300, window.innerWidth - 300 - pad);
        if (left < pad) left = pad;

        // if overflow bottom, flip to top
        const estimatedHeight = 180;
        if (top + estimatedHeight > window.innerHeight - pad) {
            top = Math.max(pad, r.top - estimatedHeight - 8);
        }

        customerHoverCard.style.top = `${top}px`;
        customerHoverCard.style.left = `${left}px`;
    }

    function showCard(el) {
        if (!customerHoverCard) return;
        placeCardNear(el);
        customerHoverCard.style.display = 'block';
    }

    function hideCard() {
        if (!customerHoverCard) return;
        customerHoverCard.style.display = 'none';
    }

    async function loadCustomerQuickInfo(customerId) {
        if (!customerId) return null;
        if (customerCache.has(customerId)) return customerCache.get(customerId);

        const res = await fetch(`/Admin/Customers/QuickInfo/${customerId}`);
        const data = await res.json();
        if (data && data.success) {
            customerCache.set(customerId, data);
            return data;
        }
        return null;
    }

    function bindHover(el, getCustomerId) {
        if (!el) return;

        let over = false;
        let hideTimer = null;

        const scheduleHide = () => {
            if (hideTimer) clearTimeout(hideTimer);
            hideTimer = setTimeout(() => {
                if (!over) hideCard();
            }, 150);
        };

        el.addEventListener('mouseenter', async () => {
            over = true;
            const id = getCustomerId();
            if (!id) return;

            showCard(el);
            // skeleton
            customerHoverCard.innerHTML = `<div class="muted">Đang tải thông tin...</div>`;

            try {
                const data = await loadCustomerQuickInfo(id);
                if (!data) {
                    customerHoverCard.innerHTML = `<div class="muted">Không lấy được thông tin khách hàng.</div>`;
                    return;
                }
                renderCustomerCard(data);
                placeCardNear(el);
            } catch {
                customerHoverCard.innerHTML = `<div class="muted">Không lấy được thông tin khách hàng.</div>`;
            }
        });

        el.addEventListener('mouseleave', () => {
            over = false;
            scheduleHide();
        });

        if (customerHoverCard) {
            customerHoverCard.addEventListener('mouseenter', () => {
                over = true;
                if (hideTimer) clearTimeout(hideTimer);
            });
            customerHoverCard.addEventListener('mouseleave', () => {
                over = false;
                scheduleHide();
            });
        }

        window.addEventListener('scroll', () => { if (customerHoverCard?.style.display === 'block') placeCardNear(el); }, { passive: true });
        window.addEventListener('resize', () => { if (customerHoverCard?.style.display === 'block') placeCardNear(el); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideCard(); });
        document.addEventListener('click', (e) => {
            if (!customerHoverCard) return;
            if (customerHoverCard.style.display !== 'block') return;
            if (customerHoverCard.contains(e.target)) return;
            if (el.contains(e.target)) return;
            hideCard();
        });
    }

    const invoiceCustomerLink = document.getElementById('invoiceCustomerLink');
    if (invoiceCustomerLink) {
        bindHover(invoiceCustomerLink, () => invoiceCustomerLink.getAttribute('data-customer-id'));
    }
</script>
}
