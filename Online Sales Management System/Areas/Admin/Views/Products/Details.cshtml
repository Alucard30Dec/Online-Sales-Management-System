@model OnlineSalesManagementSystem.Areas.Admin.Controllers.ProductsController.ProductDetailsVm
@using OnlineSalesManagementSystem.Domain.Entities
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var p = Model.Product;
}

<link rel="stylesheet" href="~/css/products-details-ui.css" asp-append-version="true" />

<div class="container-fluid py-4" style="background-color:#f8f9fc;">
    <div class="hero-header d-flex justify-content-between align-items-center">
        <i class="fas fa-box-open hero-icon-bg"></i>
        <div style="z-index:1;">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-custom mb-2">
                    <li class="breadcrumb-item"><a href="/Admin/Products">Sản phẩm</a></li>
                    <li class="breadcrumb-item active">Chi tiết</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Chi tiết sản phẩm</h2>
        </div>
        <div style="z-index:1;">
            <a href="/Admin/Products" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="card card-modern p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="prod-thumb">
                        @if (!string.IsNullOrWhiteSpace(p.ImagePath))
                        {
                            <img src="@p.ImagePath" alt="@p.Name" />
                        }
                        else
                        {
                            <div class="thumb-placeholder"><i class="fas fa-image"></i></div>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark" style="font-size:18px;">@p.Name</div>
                        <div class="text-muted small">SKU: <span class="fw-semibold">@p.SKU</span></div>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-dark border">Danh mục: @(p.Category?.Name ?? "—")</span>
                            <span class="badge bg-light text-dark border">Đơn vị: @(p.Unit?.Name ?? "—")</span>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "Active" : "Inactive")</span>
                            @if (p.IsTrending)
                            {
                                <span class="badge bg-warning text-dark"><i class="fas fa-bolt me-1"></i>Trending</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="divider my-3"></div>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-card">
                            <div class="stat-label">Tồn kho</div>
                            <div class="stat-value">@p.StockOnHand</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card">
                            <div class="stat-label">Ngưỡng đặt lại</div>
                            <div class="stat-value">@p.ReorderLevel</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="stat-card">
                            <div class="stat-label">Giá bán</div>
                            <div class="stat-value text-primary">@p.SalePrice.ToString("N0") VNĐ</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="stat-card">
                            <div class="stat-label">Mô tả</div>
                            <div class="small text-muted">@(!string.IsNullOrWhiteSpace(p.Description) ? p.Description : "—")</div>
                        </div>
                    </div>
                </div>

                <div class="divider my-3"></div>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-card">
                            <div class="stat-label">Đã bán</div>
                            <div class="stat-value text-success">@Model.TotalSoldQty</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card">
                            <div class="stat-label">Doanh thu</div>
                            <div class="stat-value text-danger">@Model.TotalRevenue.ToString("N0") VNĐ</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="card card-modern">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark"><i class="fas fa-receipt me-2 text-danger"></i>Lịch sử hóa đơn có sản phẩm này</h5>
                        <div class="text-muted small">Tra cứu theo từng hóa đơn và khách hàng</div>
                    </div>

                    <div class="search-wrap">
                        <i class="fas fa-search"></i>
                        <input id="orderSearch" class="form-control" placeholder="Tìm theo mã hóa đơn / khách hàng..." />
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-modern mb-0" id="ordersTable">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width:160px;">Mã hóa đơn</th>
                                    <th>Khách hàng</th>
                                    <th style="width:190px;">Ngày tạo</th>
                                    <th class="text-center" style="width:110px;">SL</th>
                                    <th class="text-end" style="width:150px;">Đơn giá</th>
                                    <th class="text-end pe-4" style="width:170px;">Thành tiền</th>
                                    <th class="text-center" style="width:130px;">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Orders.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">Chưa có hóa đơn nào chứa sản phẩm này.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var o in Model.Orders)
                                    {
                                        string badgeClass = o.Status switch
                                        {
                                            InvoiceStatus.Paid => "status-paid",
                                            InvoiceStatus.Cancelled => "status-cancelled",
                                            InvoiceStatus.PartiallyPaid => "status-partial",
                                            _ => "status-unpaid"
                                        };

                                        <tr class="order-row">
                                            <td class="ps-4">
                                                <a class="fw-bold text-dark text-decoration-none" href="/Admin/Invoices/Details/@o.InvoiceId">@o.InvoiceNo</a>
                                            </td>
                                            <td>
                                                @if (o.CustomerId.HasValue)
                                                {
                                                    <a href="/Admin/Customers/Details/@o.CustomerId.Value" class="fw-semibold text-decoration-none">@o.CustomerName</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@o.CustomerName</span>
                                                }
                                            </td>
                                            <td>@o.InvoiceDate.ToString("HH:mm dd/MM/yyyy")</td>
                                            <td class="text-center fw-bold">@o.Qty</td>
                                            <td class="text-end text-muted">@o.UnitPrice.ToString("N0") VNĐ</td>
                                            <td class="text-end pe-4 fw-bold">@o.LineTotal.ToString("N0") VNĐ</td>
                                            <td class="text-center"><span class="badge-status @badgeClass">@o.Status</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (Model.Orders.Count > 0)
                {
                    <div class="card-footer bg-white border-top-0 px-4 py-3 text-muted small">
                        Hiển thị <strong>@Model.Orders.Count</strong> hóa đơn chứa sản phẩm này.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const input = document.getElementById('orderSearch');
    const rows = Array.from(document.querySelectorAll('#ordersTable tbody .order-row'));

    input?.addEventListener('input', function(){
        const q = (this.value || '').toLowerCase().trim();
        rows.forEach(r => {
            const text = r.innerText.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    });
</script>
}
